import requests
from bs4 import BeautifulSoup
import pandas as pd

# Replace 'URL_OF_THE_WEBSITE' with the actual URL of the e-commerce website you want to scrape
url = "URL_OF_THE_WEBSITE"

# Send a GET request to the website
response = requests.get(url)
soup = BeautifulSoup(response.content, "html.parser")

# Find the product elements on the page (modify the selector based on the website's structure)
products = soup.find_all(
    "div", class_="product"
)  # Example class name, adjust as needed

# Create a list to store product data
product_data = []

# Extract product information
for product in products:
    name = product.find(
        "h2", class_="product-name"
    ).text.strip()  # Example class name, adjust as needed
    price = product.find(
        "span", class_="product-price"
    ).text.strip()  # Example class name, adjust as needed
    rating = product.find(
        "span", class_="product-rating"
    ).text.strip()  # Example class name, adjust as needed

    product_data.append({"Name": name, "Price": price, "Rating": rating})

# Convert the product data to a DataFrame
df = pd.DataFrame(product_data)

# Save the DataFrame to a CSV file
df.to_csv("product_data.csv", index=False)

print("Product information has been extracted and saved to product_data.csv")
